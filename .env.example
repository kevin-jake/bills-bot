# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
# Every value is read and validated once at startup; a missing required value crashes loudly.

# --- Secrets (required) ---
# From BotFather
TELEGRAM_BOT_TOKEN=

# --- Config (required) ---
# The one group chat the bot serves. Negative; supergroups look like -1001234567890.
# Find it: send a message in the group, then
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | jq '.result[].message.chat'
TELEGRAM_GROUP_CHAT_ID=

# Comma-separated Telegram user ids allowed to use the bot (Kevin, Sheena).
# Same getUpdates output, .result[].message.from.id
ALLOWED_USER_IDS=

# Path to the SQLite file. In Docker this points at the mounted volume.
SQLITE_PATH=./data/bills.db

# --- Optional ---
# Set false locally so the bot does not open cycles or post reminders while you develop.
SCHEDULER_ENABLED=true
